name: continuous-integration

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  rail:
    # The reusable rail workflow: the project's `make ci`, then `rail check --ci --json`.
    uses: hawkixs/red-rail/.github/workflows/rail-ci.yml@{{ rail_ref }}
    with:
      stack: {{ stack }}
    # No `secrets: inherit`: that hands over everything the repository holds, while rail-ci
    # declares one optional secret. Omitted entirely, `RAIL_READ_TOKEN` resolves to empty and
    # the workflow falls back to `github.token` — red-rail is public, so checking it out
    # needs no token at all.
