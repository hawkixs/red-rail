# {{ project }} task runner. Every target is what CI runs, nothing more.

.PHONY: sync lint test check ci serve image{% if stack == 'go' %} vuln{% elif stack == 'rust' %} deny{% endif %}

RAIL_FLAGS ?=

{# stack-chain: makefile -#}
{% if stack == 'python' -%}
## Install the project and its dev dependency group
sync:
	uv sync

## Lint and format check
lint:
	uv run ruff check src/ tests/
	uv run ruff format --check src/ tests/

## Run the test suite
test:
	uv run pytest -q
{% if tier == 'prod' %}
## Serve locally on 127.0.0.1:8080
serve:
	APP_HOST=127.0.0.1 uv run python -m {{ project | replace('-', '_') }}

## Build the image locally (the release builds and pushes it: `rail release`)
image:
	docker build --build-arg VERSION=dev --build-arg GIT_SHA=$$(git rev-parse HEAD) -t {{ project }}:dev .
{% endif -%}
{% elif stack == 'go' -%}
## The one way every target reaches the toolchain. On a host with no Go installed,
## `make GO=<wrapper> ci` runs all of them through the wrapper — a container, for instance.
GO ?= go

## Download the modules, then pin the analysers into go.mod and go.sum.
## `go get -tool` writes BOTH the `tool` directive and its `require` — a `tool` block alone
## carries no version and cannot resolve, so the template ships neither and this target is
## what makes `build.lint` pass. Idempotent: re-running with the same versions is a no-op.
sync:
	$(GO) mod download
	$(GO) get -tool honnef.co/go/tools/cmd/staticcheck@v0.8.1
	$(GO) get -tool golang.org/x/vuln/cmd/govulncheck@v1.8.0

## Format, vet and staticcheck (pinned by go.mod, not `@latest`). `$(GO) fmt` rewrites the
## files it lists, and a listed file fails the target. Its exit status is read before its
## list: a formatter that cannot run lists nothing, and an empty list must not pass for a
## formatted tree.
lint:
	@out="$$($(GO) fmt ./...)" || exit 1; \
	if [ -n "$$out" ]; then echo "reformatted by $(GO) fmt, commit the result:"; echo "$$out"; exit 1; fi
	$(GO) vet ./...
	$(GO) tool staticcheck ./...

## Run the test suite. `-count=1` is not a preference: `go test` caches a package's result
## from the inputs it can observe, so a guard that shells out is served from cache and stops
## guarding — a cached green is more dangerous than no test at all.
test:
	$(GO) test -race -count=1 ./...

## Known vulnerabilities reachable from this module's call graph
vuln:
	$(GO) tool govulncheck ./...
{% elif stack == 'rust' -%}
## The one way every target reaches the toolchain. On a host with no Rust installed,
## `make CARGO=<wrapper> ci` runs all of them through the wrapper — a container, for instance.
CARGO ?= cargo
## CI runs `make sync LOCKED=--locked`: a missing or stale Cargo.lock fails there instead of
## being written. Empty here, so `cargo fetch` writes the lock, or refreshes a stale one.
LOCKED ?=
## cargo-deny lives in this project's .cargo-tools, never in the shared $CARGO_HOME/bin: two
## projects pinning different versions would replace each other's binary on every sync.
export PATH := $(CURDIR)/.cargo-tools/bin:$(PATH)

## Fetch the dependencies (writes Cargo.lock), then install the pinned cargo-deny.
## Reinstalling the installed version is a no-op.
sync:
	$(CARGO) fetch $(LOCKED)
	$(CARGO) install cargo-deny --locked --version 0.20.2 --root .cargo-tools

## Format check, then clippy with warnings as errors, on every target of every member
lint:
	$(CARGO) fmt --all --check
	$(CARGO) clippy --workspace --all-targets --all-features -- -D warnings

## Run the test suite against the committed lock
test:
	$(CARGO) test --workspace --locked

## Licences, advisories, bans and sources, as deny.toml declares them
deny:
	$(CARGO) deny check
{% elif stack == 'docs' -%}
## Nothing to install for a documentation project
sync:
	@true

## Nothing to lint yet
lint:
	@true

## Nothing to test yet
test:
	@true
{% endif %}
{#- /stack-chain #}
## Run the rail gates against this repository (RAIL_FLAGS=--ci in CI)
check:
	rail check $(RAIL_FLAGS)

## What CI runs, in order
ci: lint test {% if stack == 'go' %}vuln {% elif stack == 'rust' %}deny {% endif %}check
